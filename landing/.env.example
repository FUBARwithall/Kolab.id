#--------------------------------------------------------------------
# Example Environment Configuration file for KOLAB Landing App
#
# Copy this file to .env and adjust values for your local or production environment:
#   cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
# Options: development, testing, production
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Asia/Jakarta'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (Not strictly required for landing, but available if needed)
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = kolab_landing
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION & LOGGER
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null
# logger.threshold = 4

#--------------------------------------------------------------------
# LANDING CUSTOM CONFIGURATION
# Config\Api & Config\Portal bindings
#--------------------------------------------------------------------

# Campaign API endpoint for article feeds and sitemap
landing.apiBase = 'http://localhost:8000'
landing.apiConnectTimeout = 2
landing.apiTimeout = 5
landing.apiMaxSitemapPages = 40

# Portal Redirection URLs (used on /login portal selector)
landing.campaignUrl = 'http://localhost:8000'
landing.datahubUrl = 'http://localhost:8081'
landing.contactUrl = 'mailto:hello@kolab.id'
