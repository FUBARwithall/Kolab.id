# =========================================================
# Monorepo Kolab.id (CodeIgniter 4)
#   landing/   → kolab.id        (CI4, SSR dari Campaign API)
#   campaign/  → app.kolab.id    (CI4 enterprise)
#   datahub/   → datahub.kolab.id(CI4 card generator/intelligence)
#   shared/uploads → aset upload semua app (runtime, tidak di-commit)
# =========================================================

# --- Composer & Third-Party Dependencies ---
vendor/
campaign/vendor
datahub/vendor
landing/vendor
**/vendor/
composer.phar

# --- Node / NPM Build & Dev ---
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime CI4: Writable (cache, logs, sessions, debugbar, uploads) ---
**/writable/cache/*
!**/writable/cache/index.html
!**/writable/cache/.gitkeep
**/writable/logs/*
!**/writable/logs/index.html
!**/writable/logs/.gitkeep
**/writable/session/*
!**/writable/session/index.html
!**/writable/session/.gitkeep
**/writable/debugbar/*
!**/writable/debugbar/.gitkeep
**/writable/uploads/*
!**/writable/uploads/index.html
!**/writable/uploads/.gitkeep

# --- Uploads Runtime (Symlinks di public/ dan file fisik di shared/) ---
campaign/public/uploads
datahub/public/uploads
landing/public/uploads
shared/uploads/*
!shared/uploads/.gitkeep
!shared/uploads/campaign/.gitkeep
!shared/uploads/datahub/.gitkeep
!shared/uploads/articles/.gitkeep

# --- CRUD Generator Output ---
campaign/crud-generator/downloads/Controllers/*
!campaign/crud-generator/downloads/Controllers/index.php
campaign/crud-generator/downloads/Models/*
!campaign/crud-generator/downloads/Models/index.php
campaign/crud-generator/downloads/Views/*
!campaign/crud-generator/downloads/Views/index.php

# --- Environment & Credentials ---
.env
.env.*
!.env.example
!**/.env.example
*.env
*.pem
*.key
*.crt

# --- Database & Dumps ---
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
!docs/kolab_ci4.sql

# --- PHP Testing & QA Cache ---
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache/

# --- Private configs & Out of scope ---
config-private/
whatsapp-service/
kol-sentiment-analysis/
_legacy_monorepo/

# --- IDE & Editor Junk ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# --- Scratch & Temporary Scripts ---
scratch/
test_cookie.txt

# --- OS Specific Junk Files ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~
*.swp
*.swo
