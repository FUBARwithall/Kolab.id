# ----------------------------------------------------------------------
# KOLAB.ID — Root Monorepo (.htaccess for cPanel / Apache Production)
# ----------------------------------------------------------------------

Options -Indexes +FollowSymLinks
DirectoryIndex landing/public/index.php index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Lindungi berkas sensitif dari akses HTTP langsung
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.dist\.xml|README\.md|dev-router\.php)$ - [F,L]
    RewriteRule ^(campaign|datahub|landing)/(app|writable|tests)(/.*)?$ - [F,L]

    # 2. Shared Uploads (/uploads/* -> shared/uploads/*)
    RewriteRule ^uploads/(.*)$ shared/uploads/$1 [L]
    RewriteRule ^campaign/uploads/(.*)$ shared/uploads/$1 [L]
    RewriteRule ^datahub/uploads/(.*)$ shared/uploads/$1 [L]

    # 3. AdminLTE Assets (/asset/* -> campaign/public/asset/*)
    RewriteRule ^asset/(.*)$ campaign/public/asset/$1 [L]
    RewriteRule ^assets/adminlte/(.*)$ campaign/public/asset/$1 [L]
    RewriteRule ^campaign/asset/(.*)$ campaign/public/asset/$1 [L]
    RewriteRule ^datahub/asset/(.*)$ campaign/public/asset/$1 [L]

    # 4. Landing Assets (/dist/* dan /assets/*)
    RewriteRule ^dist/(.*)$ landing/public/dist/$1 [L]
    RewriteRule ^assets/(.*)$ landing/public/assets/$1 [L]
    RewriteRule ^favicon\.ico$ landing/public/favicon.ico [L]
    RewriteRule ^robots\.txt$ landing/public/robots.txt [L]

    # 5. Sub-aplikasi Campaign (/campaign/*)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^campaign/public/(.*)$ campaign/public/$1 [L]
    RewriteRule ^campaign/?(.*)$ campaign/public/index.php [L,QSA]

    # 6. Sub-aplikasi Datahub (/datahub/*)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^datahub/public/(.*)$ datahub/public/$1 [L]
    RewriteRule ^datahub/?(.*)$ datahub/public/index.php [L,QSA]

    # 7. Sub-aplikasi Landing (Default Route /)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ landing/public/index.php [L,QSA]
</IfModule>
